# ─────────────────────────────────────────────────────────────────────────────
# Adobe Real-Time CDP — connect the live tenant (Coforge sandbox)
# Copy to `.env` (which is gitignored) OR, in production on AWS, inject these from
# AWS Secrets Manager / SSM Parameter Store. NEVER commit the client secret.
# The secret shared in chat must be ROTATED in the Adobe Developer Console first.
# ─────────────────────────────────────────────────────────────────────────────

ADOBE_CDP_ENABLED=1
ADOBE_IMS_ORG=65B229AE5ED637A00A495E96@AdobeOrg
ADOBE_CLIENT_ID=4f40cf53cb4e4c209d15370b6ea7a209
# ↓ paste the ROTATED secret here locally / load from Secrets Manager — do not commit
ADOBE_CLIENT_SECRET=__PASTE_ROTATED_SECRET_HERE__
ADOBE_SANDBOX=coforge3

# ── Identity to look up by ──
# For the MULTI-PERSONA demo, look up by LOYALTY ID (unique per persona) — not email,
# because DEMO_EMAIL_TO makes all personas share one email. Get the loyalty namespace
# SYMBOL from GET /api/admin/cdp/namespaces (or AEP > Admin > Identities) and set it here:
ADOBE_IDENTITY_NS=__LOYALTY_NAMESPACE_SYMBOL__
ADOBE_LOOKUP_ATTR=loyalty
# (To look up by email instead, set ADOBE_IDENTITY_NS=Email and ADOBE_LOOKUP_ATTR=email.)
# Optional: force one known identity for a quick connection test
# ADOBE_LOOKUP_VALUE=PT-884512

# Always the union profile view for the read path (leave as-is):
ADOBE_PROFILE_VIEW=_xdm.context.profile

# ── INGESTION (writing the personas INTO CDP so profiles look as rich as SQLite) ──
ADOBE_PROFILE_SCHEMA_ID=https://ns.adobe.com/aeppsemea/schemas/4a538027b8b70a4e2e7ae28849ba7e8c3962856add0917be
ADOBE_EVENT_SCHEMA_ID=https://ns.adobe.com/aeppsemea/schemas/8f9c109a99b357190784d9a0b0306fc9c79c23e22b11b46d
ADOBE_PROFILE_DATASET_ID=6a2ed5da5851aaac8bc69d1c
ADOBE_EVENT_DATASET_ID=6a30e64ba4428172f3d4e491
# Loyalty-id namespace SYMBOL (same value as ADOBE_IDENTITY_NS above when keying on loyalty):
ADOBE_LOYALTY_NS=__LOYALTY_NAMESPACE_SYMBOL__
# Tenant namespace for custom fields is auto-derived from the schema URL (_aeppsemea);
# override only if needed: ADOBE_TENANT_NS=_aeppsemea

# ── Optional overrides (sensible defaults already set) ──
# ADOBE_PROFILE_API=https://platform.adobe.io/data/core/ups
# ADOBE_IMS_URL=https://ims-na1.adobelogin.com/ims/token/v3
# ADOBE_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext,session
